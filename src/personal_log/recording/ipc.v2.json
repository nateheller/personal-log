{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Log recorder IPC version 2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "message_id", "session_id", "created_at", "payload"],
  "$defs": {
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  },
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "kind": {"enum": ["command", "status"]},
    "message_id": {"$ref": "#/$defs/id"},
    "session_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"properties": {
      "session_id": {"$ref": "#/$defs/id"},
      "payload": {"type": "object", "additionalProperties": false,
        "required": ["operation", "controller_id", "sequence"],
        "properties": {
          "operation": {"enum": ["record", "pause", "resume", "finish", "heartbeat", "shutdown"]},
          "controller_id": {"$ref": "#/$defs/id"},
          "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775806},
          "entry_id": {"$ref": "#/$defs/id"},
          "reason": {"enum": ["normal_shutdown", "ui_crash", "windows_shutdown"]}
        }
      }
    }}},
    {"if": {"properties": {"kind": {"const": "status"}}}, "then": {"properties": {
      "payload": {"type": "object", "additionalProperties": false,
        "required": ["state", "code", "sequence"],
        "properties": {
          "state": {"enum": ["idle", "starting", "recording", "pausing", "paused", "resuming", "finalizing", "finished", "interrupted", "recovery_required"]},
          "code": {"enum": ["ready", "snapshot", "ack", "rejected", "interrupted", "stopped", "startup_failed"]},
          "sequence": {"type": "integer", "minimum": 0},
          "command_id": {"$ref": "#/$defs/id"},
          "error_code": {"enum": ["invalid_message", "not_owner", "stale_sequence", "command_conflict", "busy", "invalid_state", "wrong_session", "shutting_down", "storage_failed", "capture_failed", "control_timeout", "ui_crash", "recorder_crash", "windows_shutdown", "startup_failed"]},
          "next_sequence": {"type": "integer", "minimum": 0},
          "captured_frames": {"type": "integer", "minimum": 0},
          "written_frames": {"type": "integer", "minimum": 0},
          "recovery_findings": {"type": "integer", "minimum": 0},
          "worker_pid": {"type": "integer", "minimum": 1}
        }
      }
    }}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Log recorder boundary contract version 1",
  "type": "object",
  "required": ["schema_version", "kind", "message_id", "session_id", "created_at", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"enum": ["command", "event"]},
    "message_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "payload": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "command"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "controller_id", "sequence"],
        "properties": {
          "operation": {"enum": ["record", "pause", "resume", "finish", "heartbeat", "shutdown"]},
          "controller_id": {"$ref": "#/$defs/id"},
          "sequence": {"type": "integer", "minimum": 0}
        }
      }}}
    },
    {
      "if": {"properties": {"kind": {"const": "event"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "code", "sequence"],
        "properties": {
          "state": {"enum": ["starting", "recording", "pausing", "paused", "resuming", "finalizing", "finished", "interrupted", "recovery_required"]},
          "code": {"enum": ["state_changed", "command_acknowledged", "control_timeout", "ui_crash", "recorder_crash", "windows_shutdown", "normal_shutdown", "capture_failed", "storage_failed", "recovery_required"]},
          "sequence": {"type": "integer", "minimum": 0},
          "command_id": {"$ref": "#/$defs/id"}
        }
      }}}
    }
  ]
}
